# Exact math works with these values empty. Never commit .env.
# Set AI_PROVIDER=ollama for the local zero-API-cost route.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=700
SOLVER_TIMEOUT_SECONDS=8
